# 服务端口
PORT=8787

# 生产环境务必替换：JWT 签名密钥与数据加密密钥
JWT_SECRET=replace-with-a-long-random-string
APP_SECRET=replace-with-another-long-random-string

# 可选：自定义数据目录（默认 ./data）
# ASTRA_DATA_DIR=./data

# 可选：允许的前端地址，逗号分隔（开发环境默认全部允许）
# CORS_ORIGINS=http://localhost:5173

# 可选：向量数据库（PostgreSQL + pgvector）。不配置则使用本地 SQLite 向量存储
# 生产环境强烈建议配置；Docker Compose 已自动配置
# VECTOR_DATABASE_URL=postgres://astra:astra@127.0.0.1:5432/astra

# 可选：登录有效期
JWT_EXPIRES_IN=7d
